@page "/"
@using AlexiTheMVCBot.Djs
@inject IChatProxy ChatProxy

<p><a href="/group">DJ group rehearsal (development only)</a></p>

<div class="chat-widget">
    @if (isOpen)
    {
        <section class="chat-panel" aria-label="Private AI DJ chat">
            <header class="chat-header">
                <div class="chat-title-wrap">
                    <img class="chat-avatar" src="@Selected.ImagePath"
                         onerror="this.onerror=null;this.src='img/androgynous-avatar-non-binary-queer-person.jpg';"
                         alt="@Selected.Name avatar" />
                    <div>
                        <h1>@Selected.Name</h1>
                        <p>@Selected.Role · Fictional AI DJ</p>
                    </div>
                </div>
                <button type="button" class="chat-close" @onclick="ToggleOpen" aria-label="Close chat">×</button>
            </header>

            <label class="dj-picker-label" for="dj-picker">Talk privately with</label>
            <select id="dj-picker" class="dj-picker" value="@selectedDjId" @onchange="SelectDj" disabled="@isSending">
                @foreach (var dj in DjProfiles.All)
                {
                    <option value="@dj.Id">@dj.Name — @dj.Role</option>
                }
            </select>
            <p class="dj-bio">@Selected.Bio</p>

            <div class="chat-body" aria-live="polite">
                @if (Messages.Count == 0)
                {
                    <div class="chat-empty">Say hello to @Selected.Name.</div>
                }
                else
                {
                    @foreach (var message in Messages)
                    {
                        <article class="chat-message @(message.Role == "user" ? "from-user" : "from-bot")">
                            <p>@message.Content</p>
                        </article>
                    }
                }
                @if (!string.IsNullOrEmpty(errorMessage))
                {
                    <p role="alert" class="chat-error">@errorMessage</p>
                }
            </div>

            <EditForm Model="this" OnSubmit="SendMessageAsync" class="chat-input-row">
                <InputTextArea @bind-Value="userInput" class="chat-input"
                               placeholder="Type your message..." maxlength="1000"
                               aria-label="Message to selected DJ" />
                <button type="submit" class="chat-send" disabled="@isSending">@(isSending ? "..." : "Send")</button>
            </EditForm>
        </section>
    }

    <button type="button" class="chat-launcher" @onclick="ToggleOpen"
            aria-label="@(isOpen ? "Hide DJ chat" : "Open DJ chat")">
        @(isOpen ? "Hide chat" : "Talk to a DJ")
    </button>
</div>

@code {
    private readonly Dictionary<string, List<ChatMessage>> conversations = new(StringComparer.OrdinalIgnoreCase);
    private readonly Queue<DateTimeOffset> recentRequests = new();
    private string selectedDjId = "kathleen";
    private string userInput = string.Empty;
    private string? errorMessage;
    private bool isOpen;
    private bool isSending;

    private DjProfile Selected => DjProfiles.Get(selectedDjId);
    private List<ChatMessage> Messages
    {
        get
        {
            if (!conversations.TryGetValue(selectedDjId, out var messages))
                conversations[selectedDjId] = messages = [];
            return messages;
        }
    }

    private void ToggleOpen() => isOpen = !isOpen;

    private void SelectDj(ChangeEventArgs args)
    {
        selectedDjId = DjProfiles.Get(args.Value?.ToString()).Id;
        userInput = string.Empty;
        errorMessage = null;
    }

    private async Task SendMessageAsync()
    {
        if (isSending || string.IsNullOrWhiteSpace(userInput))
            return;

        errorMessage = null;
        var prompt = userInput.Trim();
        if (prompt.Length > 1000)
        {
            errorMessage = "Please keep your message under 1,000 characters.";
            return;
        }

        var now = DateTimeOffset.UtcNow;
        while (recentRequests.Count > 0 && now - recentRequests.Peek() > TimeSpan.FromMinutes(1))
            recentRequests.Dequeue();
        if (recentRequests.Count >= 8)
        {
            errorMessage = "Too many messages. Please try again in a minute.";
            return;
        }
        recentRequests.Enqueue(now);

        isSending = true;
        userInput = string.Empty;
        var djId = selectedDjId;
        Messages.Add(new ChatMessage { Role = "user", Content = prompt });

        try
        {
            var response = await ChatProxy.SendChatMessage(prompt, djId);
            conversations[djId].AddRange(response);
        }
        catch (Exception)
        {
            // Never expose Ollama or infrastructure details to public visitors.
            errorMessage = "Your DJ couldn't respond right now. Please try again shortly.";
        }
        finally
        {
            isSending = false;
        }
    }
}
