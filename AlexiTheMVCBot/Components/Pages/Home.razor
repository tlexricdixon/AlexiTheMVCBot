@page "/"
@implements IDisposable
@using AlexiTheMVCBot.ChatGpt
@using AlexiTheMVCBot.Djs
@inject IChatProxy ChatProxy

<p><a href="/group">DJ group rehearsal (development only)</a></p>

<div class="chat-widget">
    @if (isOpen)
    {
        <section class="chat-panel" aria-label="Private AI DJ chat" aria-busy="@isSending">
            <header class="chat-header">
                <div class="chat-title-wrap">
                    <img class="chat-avatar" src="@Selected.ImagePath"
                         onerror="this.onerror=null;this.src='img/androgynous-avatar-non-binary-queer-person.jpg';"
                         alt="@Selected.Name avatar" />
                    <div>
                        <h1>@Selected.Name</h1>
                        <p>@Selected.Role · Fictional AI DJ</p>
                    </div>
                </div>
                <button type="button" class="chat-close" @onclick="ToggleOpen" aria-label="Close chat">×</button>
            </header>

            <label class="dj-picker-label" for="dj-picker">Talk privately with</label>
            <select id="dj-picker" class="dj-picker" value="@selectedDjId" @onchange="SelectDj" disabled="@isSending">
                @foreach (var dj in DjProfiles.All)
                {
                    <option value="@dj.Id">@dj.Name — @dj.Role</option>
                }
            </select>
            <p class="dj-bio">@Selected.Bio</p>

            <div class="chat-body" aria-live="polite">
                @if (Messages.Count == 0 && string.IsNullOrWhiteSpace(pendingPrompt))
                {
                    <div class="chat-empty">Say hello to @Selected.Name.</div>
                }
                else
                {
                    @foreach (var message in Messages)
                    {
                        <article class="chat-message @(message.Role == "user" ? "from-user" : "from-bot")">
                            <p>@message.Content</p>
                        </article>
                    }
                }

                @if (!string.IsNullOrWhiteSpace(pendingPrompt))
                {
                    <article class="chat-message from-user chat-pending-user">
                        <p>@pendingPrompt</p>
                    </article>
                    <article class="chat-message from-bot chat-pending-bot" aria-live="polite">
                        <p>@Selected.Name is thinking…</p>
                    </article>
                }
            </div>

            <div class="chat-feedback" aria-live="polite" role="status">@statusMessage</div>
            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <p role="alert" aria-live="assertive" class="chat-error">@errorMessage</p>
            }

            <EditForm Model="this" OnSubmit="SendMessageAsync" class="chat-input-row">
                <label class="chat-input-label" for="chat-input">Message to @Selected.Name</label>
                <textarea id="chat-input"
                          @bind="userInput"
                          class="chat-input"
                          placeholder="Type your message..."
                          maxlength="1000"
                          disabled="@isSending"
                          @ref="inputRef"></textarea>
                <button type="submit" class="chat-send" disabled="@isSending">@(isSending ? "Sending..." : "Send")</button>
            </EditForm>
        </section>
    }

    <button type="button" class="chat-launcher" @onclick="ToggleOpen"
            @ref="launcherRef"
            aria-expanded="@isOpen"
            aria-label="@(isOpen ? "Hide DJ chat" : "Open DJ chat")">
        @(isOpen ? "Hide chat" : "Talk to a DJ")
    </button>
</div>

@code {
    private const int MaxInputLength = 1000;
    private const int MaxRequestsPerMinute = 8;
    private const int ConversationDisplayLimit = 40;
    private static readonly TimeSpan SendTimeout = TimeSpan.FromSeconds(45);

    private readonly Queue<DateTimeOffset> recentRequests = new();
    private readonly CancellationTokenSource disposeCts = new();
    private CancellationTokenSource? sendCts;

    private string selectedDjId = "kathleen";
    private string userInput = string.Empty;
    private string? pendingPrompt;
    private string? errorMessage;
    private string? statusMessage;
    private bool isOpen;
    private bool isSending;
    private bool focusInputOnOpen;
    private bool focusLauncherOnClose;
    private ElementReference launcherRef;
    private ElementReference inputRef;

    private DjProfile Selected => DjProfiles.Get(selectedDjId);
    private IReadOnlyList<ChatMessage> Messages => ChatProxy.GetConversation(selectedDjId, ConversationDisplayLimit);

    private async Task ToggleOpen()
    {
        isOpen = !isOpen;
        if (isOpen)
        {
            focusInputOnOpen = true;
        }
        else
        {
            focusLauncherOnClose = true;
            sendCts?.Cancel();
            pendingPrompt = null;
            statusMessage = null;
        }

        await InvokeAsync(StateHasChanged);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (focusInputOnOpen)
        {
            focusInputOnOpen = false;
            await inputRef.FocusAsync();
        }

        if (focusLauncherOnClose)
        {
            focusLauncherOnClose = false;
            await launcherRef.FocusAsync();
        }
    }

    private void SelectDj(ChangeEventArgs args)
    {
        if (isSending)
            return;

        selectedDjId = DjProfiles.Get(args.Value?.ToString()).Id;
        userInput = string.Empty;
        pendingPrompt = null;
        errorMessage = null;
        statusMessage = null;
    }

    private async Task SendMessageAsync()
    {
        if (isSending)
            return;

        var prompt = userInput.Trim();
        if (string.IsNullOrWhiteSpace(prompt))
            return;

        errorMessage = null;
        statusMessage = null;

        if (prompt.Length > MaxInputLength)
        {
            errorMessage = "Please keep your message under 1,000 characters.";
            return;
        }

        var now = DateTimeOffset.UtcNow;
        while (recentRequests.Count > 0 && now - recentRequests.Peek() > TimeSpan.FromMinutes(1))
            recentRequests.Dequeue();

        if (recentRequests.Count >= MaxRequestsPerMinute)
        {
            errorMessage = "Too many messages. Please try again in a minute.";
            return;
        }

        recentRequests.Enqueue(now);

        isSending = true;
        var djId = selectedDjId;
        pendingPrompt = prompt;
        statusMessage = $"Waiting for {Selected.Name}...";

        sendCts?.Dispose();
        sendCts = CancellationTokenSource.CreateLinkedTokenSource(disposeCts.Token);
        sendCts.CancelAfter(SendTimeout);

        try
        {
            await ChatProxy.SendChatMessage(prompt, djId, sendCts.Token);
            if (selectedDjId == djId)
                userInput = string.Empty;
        }
        catch (ChatRequestFailedException ex)
        {
            userInput = prompt;
            errorMessage = ex.UserMessage;
        }
        catch (ArgumentException)
        {
            userInput = prompt;
            errorMessage = "Please keep your message under 1,000 characters.";
        }
        catch (Exception)
        {
            userInput = prompt;
            errorMessage = "Your DJ couldn't respond right now. Please try again shortly.";
        }
        finally
        {
            pendingPrompt = null;
            statusMessage = null;
            isSending = false;
        }
    }

    public void Dispose()
    {
        disposeCts.Cancel();
        sendCts?.Cancel();
        sendCts?.Dispose();
        disposeCts.Dispose();
    }
}
